// ══════════════════════════════════════════════════════════════
// MODELS — Wave 2: ERP data migrated from the legacy fileDB (db.json)
//
// Design notes (read before changing these):
//  • `id` has NO default and is NOT auto-generated. The migration imports the
//    original legacy `_id`, which keeps every cross-reference (plot.currentOwner
//    -> member id, payment allocations -> installment id) intact. Do not switch
//    these to @default(uuid()).
//  • Cross-entity references are plain `String` columns, not Prisma relations.
//    The legacy data contains loose references that do not always resolve, and
//    real FKs would abort the import. Typed relations can be introduced later,
//    once the data is clean.
//  • Status/priority columns are `String`, not the enums above, so that a value
//    present in db.json can never fail an insert. Enums are applied when the
//    individual services are rewritten (S4.2+).
//  • All money is `Decimal` — never Float.
//  • Embedded arrays/objects (documents, approvalStages, comments, items) are
//    `Json` to preserve them exactly as stored.
// ══════════════════════════════════════════════════════════════

model Member {
  id                String    @id
  memberId          String?
  membershipNumber  String?
  /// Nullable for legacy parity: the fileDB accepted member documents that
  /// carried only `fullName` and no `name` (e.g. records written by imports
  /// and tests). Member.create always sets `name`.
  name              String?
  /// Alternate name field present in some legacy records.
  fullName          String?
  fatherName        String?
  cnic              String?
  phone             String?
  email             String?
  /// Json because the legacy shape is polymorphic: most records hold a plain
  /// address string, some hold {current, permanent}.
  address           Json?
  /// Json for the same reason: either a string or {mobile, email, ...}.
  contact           Json?
  nominee           Json?
  status            String?
  photo             String?
  documents         Json?
  userId            String?
  createdBy         String?
  createdAt         DateTime?
  updatedAt         DateTime?

  @@index([cnic])
  @@index([memberId])
  @@map("members")
}

model Plot {
  id           String    @id
