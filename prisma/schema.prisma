// ══════════════════════════════════════════════════════════════
// MODELS — Wave 1: identity, RBAC, administration
//
// Conventions (must match prisma/migrations/.../add_constraints_and_indexes):
//   - table names are snake_case via @@map
//   - column names stay camelCase (unmapped), quoted in raw SQL
// ══════════════════════════════════════════════════════════════

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  phone              String?
  /// Legacy portal-link: the member this login is bound to. Kept as a plain
  /// String reference for compatibility with the fileDB shape.
  memberId           String?
  /// Nullable for parity with the legacy store, which allowed password-less
  /// rows (service/staff accounts created for reference only). Such an account
  /// cannot log in: AuthService rejects a login when this is null.
  passwordHash       String?
  isActive           Boolean   @default(true)
  mustResetPassword  Boolean   @default(false)
  lastLoginAt        DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy    User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]    @relation("UserCreatedBy")
  userRoles    UserRole[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  permissions  String[] @default([])
  isSystemRole Boolean  @default(false)
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles UserRole[]
  accesses  RoleModuleAccess[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RbacModule {
  id            String  @id @default(uuid())
  key           String  @unique
  label         String
  description   String?
  group         String?
  icon          String?
  route         String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)
  showInSidebar Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accesses RoleModuleAccess[]

  @@map("rbac_modules")
}

model RoleModuleAccess {
  id          String   @id @default(uuid())
  roleId      String
  moduleId    String
  isVisible   Boolean  @default(false)
  actions     Json     @default("{}")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role   Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module RbacModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@map("role_module_access")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  /// Nullable: createAuditLog() defaults entityType to null, and several
  /// call sites log an action without naming an entity.
  entityType String?
  entityId   String?
  action     String
  ip         String?
  userAgent  String?
  status     String?
  changes    Json?
  meta       Json?
  timestamp  DateTime @default(now())
  createdAt  DateTime?
  updatedAt  DateTime? @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

/// Generic key/value store also used by the RBAC migration fingerprint
/// marker (type = "rbacMigration", name = "migration").
model MasterData {
  id          String   @id @default(uuid())
  type        String
  name        String
  code        String?
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, name])
  @@map("master_data")
}

/// Table name and column names are referenced directly by
/// src/modules/administration/numbering.service.js raw SQL
/// (UPDATE "numbering_rules" ... RETURNING "currentSequence", ...).
model NumberingRule {
  id               String                 @id @default(uuid())
  entityType       String                 @unique
  prefix           String
  currentSequence  Int                    @default(0)
  padLength        Int                    @default(6)
  resetPolicy      NumberingResetPolicy   @default(never)
  lastResetPeriod  String?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("numbering_rules")
}

