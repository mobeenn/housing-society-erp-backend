  recoveryAllowSelfReserve  Boolean  @default(false)
  contactInfo               Json     @default("{}")
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("society_settings")
}

