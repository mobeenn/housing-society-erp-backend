model Employee {
  id                String    @id
  employeeId        String?
  name              String
  cnic              String?
  phone             String?
  email             String?
  /// Free-text department name. Kept because the API returns it and because
  /// records can carry a name with no matching departments row (e.g. an
  /// employee created against a department that is not registered yet).
  department        String?
  /// Resolved foreign key to departments. Backfilled from `department` by
  /// name; NULL when the name does not match a department. Display continues to
  /// use `department`, so nothing in the API changes.
  departmentId      String?
  designation       String?
  joiningDate       DateTime?
  dateOfBirth       DateTime?
  address           String?
  emergencyContact  Json?
  linkedUser        String?
  documents         Json?
  basicSalary       Decimal?  @db.Decimal(14, 2)
  allowances        Decimal?  @db.Decimal(14, 2)
  deductions        Decimal?  @db.Decimal(14, 2)
  bankAccount       String?
  /// Per-employee salary component breakdown.
  salaryStructure   Json?
  status            String?
  remarks           String?
  createdBy         String?
  createdAt         DateTime?
  updatedAt         DateTime?

  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([departmentId])
  @@map("employees")
}

