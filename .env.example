# ─── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (Supabase Postgres) ─────────────────────────────────
# Runtime connection: pooled session mode (port 5432 here).
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
#   Choose the "Session pooler" URI and append ?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?schema=public
# Migrations must NOT run through the transaction pooler.
# Append ?schema=public to the "Direct connection"/IPv4 URI (port 5432).
DIRECT_URL=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?schema=public

# ─── JWT ──────────────────────────────────────────────────────────
# Generate each independently, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, e.g.
# https://housing-society-erp-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000

# ─── Super Admin (used by the seed script only) ────────────────────
# The seed refuses to run if the password is weak or left as the placeholder.
SUPERADMIN_EMAIL=admin@your-society.example
SUPERADMIN_PASSWORD=change_me_in_production

# ─── Supabase (server-side only) ───────────────────────────────────
# SUPABASE_SECRET_KEY bypasses RLS - server-side only, never sent to the
# frontend, never logged. Leave unset if you do not use Supabase Storage yet.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SECRET_KEY=replace_with_secret_key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ─── Storage ──────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents
SUPABASE_STORAGE_BUCKET_GENERATED=generated-pdfs
SUPABASE_STORAGE_BUCKET_PHOTOS=photos
SIGNED_URL_EXPIRY_SECONDS=300