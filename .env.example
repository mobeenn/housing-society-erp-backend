# ── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Storage ──────────────────────────────────────
# Local development stores data in backend/data/db.json.
# Vercel demo mode uses os.tmpdir() and resets data when the function is recycled.

# ── JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS and refresh cookie ──────────────────────
# Comma-separated origins are supported.
CORS_ORIGIN=http://localhost:3000,https://housing-society-erp-frontend.vercel.app
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
# On the Vercel production deployment use:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# ── Super Admin (for seed script) ───────────────
SUPERADMIN_EMAIL=admin@housing-society.local
SUPERADMIN_PASSWORD=SuperAdmin@123
