# ─── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (Supabase Postgres) ─────────────────────────────────
# Runtime connection: pooled session mode (port 5432 here).
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
#   Choose the "Session pooler" URI and append ?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?schema=public
# Migrations must NOT run through the transaction pooler.
# Append ?schema=public to the "Direct connection"/IPv4 URI (port 5432).
DIRECT_URL=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?schema=public

# ─── JWT ──────────────────────────────────────────────────────────
# Generate each independently, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, e.g.
# https://housing-society-erp-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000

# ─── Super Admin (used by the seed script only) ────────────────────
# The seed refuses to run if the password is weak or left as the placeholder.
SUPERADMIN_EMAIL=admin@your-society.example
SUPERADMIN_PASSWORD=change_me_in_production

# ─── Demo seeds (development only) ─────────────────────────────────
# Demo/development seed scripts refuse to run when NODE_ENV=production
# unless this is explicitly set to true. Never enable in a live society DB.
# ALLOW_DEMO_SEED=true

# ─── Public app URL (password-reset links) ─────────────────────────
# APP_PUBLIC_URL=https://your-frontend.vercel.app

# ─── Supabase Postgres project (optional metadata; DB uses DATABASE_URL) ─
# Documents use Vercel Blob (prod) or local backend/uploads (dev) — not Supabase Storage.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
# SUPABASE_SECRET_KEY=replace_with_secret_key
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ─── Document storage (production) ─────────────────────────────────
# When any of these are set, documents go to Vercel Blob; otherwise local uploads/.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# ─── Health / ops ──────────────────────────────────────────────────
# Optional shared secret for GET /api/health/deep (header: x-health-check-token).
# Super Admin JWT also works. Leave unset to require Super Admin only.
# HEALTH_CHECK_TOKEN=replace_with_a_long_random_string

# Vercel Cron / GET /api/recovery/cron/auto-block (Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=replace_with_a_long_random_string

# ─── Email (SMTP) ──────────────────────────────────────────────────
# When SMTP_HOST is set, outbound email is sent via nodemailer.
# Without SMTP_HOST the email channel stays stubbed (SMS/WhatsApp always stubbed).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Civica <noreply@example.com>"