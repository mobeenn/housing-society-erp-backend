{
  "name": "housing-society-erp-backend",
  "version": "1.0.0",
  "description": "Civica — REST API backend",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node scripts/runTests.js",
    "test:rbac:e2e": "node test-rbac-e2e.js",
    "invoices:backfill": "node src/seeds/backfillInvoices.js",
    "storage:import": "node scripts/importLocalDataToBlob.js",
    "seed": "npm run seed:roles && npm run seed:administration && npm run seed:numbering && npm run rbac:seed && npm run recovery:seed && npm run hr-payroll:seed && npm run phase15:seed",
    "recovery:seed": "node src/seeds/seedRecoveryAccess.js",
    "hr-payroll:seed": "node src/seeds/seedHrPayrollAccess.js",
    "phase15:seed": "node src/seeds/seedPhase15Access.js",
    "seed:demo": "node src/seeds/seedDevelopmentData.js",
    "seed:phase8": "node src/seeds/seedPhase8.js",
    "rbac:seed": "node src/seeds/seedRbacModules.js",
    "rbac:migrate": "node src/seeds/seedRbacModules.js",
    "rbac:migrate:force": "node src/seeds/seedRbacModules.js --force",
    "seed:development": "npm run seed && npm run seed:demo && npm run seed:phase8 && npm run rbac:seed && npm run invoices:backfill",
    "seed:roles": "node src/seeds/seedRolesAndSuperAdmin.js",
    "seed:administration": "node src/seeds/seedAdministration.js",
    "seed:numbering": "node src/seeds/seedNumberingRules.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prisma:seed": "prisma db seed",
    "db:import:legacy": "node scripts/migrateFileDbToPostgres.js",
    "db:import:legacy:dry": "node scripts/migrateFileDbToPostgres.js --dry-run",
    "db:verify:import": "node scripts/verifyImport.js --manifest",
    "db:verify:import:file": "node scripts/verifyImport.js",
    "db:verify:runtime": "node scripts/verifyRuntime.js",
    "db:baseline:save": "node scripts/snapshotBaseline.js save",
    "db:baseline:restore": "node scripts/snapshotBaseline.js restore",
    "hr:backfill-departments": "node scripts/backfillEmployeeDepartments.js",
    "db:verify:reports": "node scripts/verifyReports.js",
    "test:file": "node scripts/runTests.js --no-setup"
  },
  "keywords": [
    "housing-society",
    "erp",
    "express",
    "file-database",
    "postgresql-migration"
  ],
  "license": "PRIVATE",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/server": "^1.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0"
  }
}
